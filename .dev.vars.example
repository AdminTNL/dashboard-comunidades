# Copie este arquivo para ".dev.vars" (nunca commitado) e preencha com os valores reais
# do projeto Supabase, pra rodar "npm run dev" localmente com o wrangler.
#
# Em produção, essas mesmas chaves devem ser cadastradas em:
# Cloudflare Dashboard -> Pages -> dashboard-comunidades -> Settings -> Environment variables
# (como "Secret", não "Plaintext" - especialmente a service role key).

SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=coloque-a-service-role-key-aqui

# Segredo usado para assinar o cookie de sessao (HMAC). Gere algo aleatorio e
# longo (ex.: openssl rand -hex 32) - nunca reaproveite entre ambientes.
AUTH_SECRET=troque-por-uma-string-aleatoria-longa

# Segredo compartilhado com o Painel de Mobilizacao (mesma var EMBED_SECRET la).
# O Painel assina um token curto de embed com ele; aqui validamos a assinatura.
# Use um valor diferente do AUTH_SECRET.
EMBED_SECRET=troque-por-outra-string-aleatoria-longa

# Opcional: origens que podem embutir o dashboard em iframe (separadas por espaco).
# Padrao: https://painel-mobilizacao.netlify.app
EMBED_ALLOWED_ORIGINS=

# Senha de admin: acessa qualquer projeto via /admin.html
PASS_ADMIN=

# Uma senha por projeto (chave = PASS_<CHAVE DO PROJETO EM MAIUSCULO>,
# mesma chave usada em public/config/projetos.json e na URL ?projeto=)
PASS_PE=
PASS_PA=
PASS_MS=
PASS_ESCALADA=
PASS_ESCALA6X1=
PASS_LARA=
